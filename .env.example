# Copy this file to .env and fill in real values. Never commit .env.

ENV=development

# Postgres (used directly by the api container and by alembic)
POSTGRES_USER=recovery
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recovery_copilot
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://recovery:change-me@db:5432/recovery_copilot

# Razorpay test-mode credentials (https://dashboard.razorpay.com/app/keys, Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# LLM diagnosis for failure reasons the rule table doesn't recognize (src/llm_diagnosis.py).
# Currently wired to Groq's OpenAI-compatible chat completions API (the working credential
# available at build time) — the diagnosis contract (root_cause/confidence/retryable/evidence,
# DiagnosisSource.LLM) is provider-agnostic; swapping to Anthropic/Claude directly is a contained
# change to src/llm_diagnosis.py alone. Get a key at https://console.groq.com/keys.
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
